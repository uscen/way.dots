# =============================================================================== #
# Grub boot loader configuration:                                                 #
# =============================================================================== #
GRUB_DEFAULT=0
GRUB_TIMEOUT=0
GRUB_DISTRIBUTOR="Void"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=0 console=tty2 udev.log_level=0 vt.global_cursor_default=0 \
  pci=pcie_bus_perf pcie_aspm=force pcie_aspm.policy=performance cpufreq.default_governor=performance \
  msr.allow_writes=on mitigations=off nowatchdog module.sig_unenforce \
  "
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_SUBMENU=true
