# =============================================================================== #
# Grub boot loader configuration:                                                 #
# =============================================================================== #
GRUB_DEFAULT=0
GRUB_TIMEOUT=0
GRUB_DISTRIBUTOR="Void"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=0 console=tty2 udev.log_level=0"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=0 console=tty2 udev.log_level=0 \
  vt.global_cursor_default=0 mitigations=off nowatchdog \
  nvme_load=YES nvme_core.default_ps_max_latency_us=1000 \
  msr.allow_writes=on pci=pcie_bus_perf pcie_aspm=force pcie_aspm.policy=performance cpufreq.default_governor=performance module.sig_unenforce \
  intel_idle.max_cstate=4 processor.ignore_ppc=1 thermal.off=1 cryptomgr.notests initcall_debug \
  iommu=pt idle=nomwait intel_iommu=igfx_off no_timer_check noreplace-smp \
  page_alloc.shuffle=1 rcupdate.rcu_expedited=1 tsc=reliable \
  "
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_SUBMENU=true
