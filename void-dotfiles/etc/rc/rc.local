#!/bin/sh
# =============================================================================== #
# Local:                                                                          #
# =============================================================================== #
# This is run by runit in stage 2 before the services are executed (see /etc/runit/2)

# =============================================================================== #
# Brightenss:                                                                     #
# =============================================================================== #
echo 17454 > /sys/class/backlight/intel_backlight/brightness

# =============================================================================== #
# Performance:                                                                    #
# =============================================================================== #
echo performance > /sys/firmware/acpi/platform_profile
