// ============================================================================== #
// Startup:                                                                       #
// ============================================================================== #
spawn-sh-at-startup "~/.config/niri/scripts/autostart.sh"
spawn-sh-at-startup "~/.config/niri/scripts/theme.sh"

// ============================================================================== #
// General:                                                                       #
// ============================================================================== #
// Window: =======================================================================================
prefer-no-csd

// Screenshots: ==================================================================================
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"
config-notification {
    disable-failed
}

// Clipboard: ====================================================================================
clipboard {
    disable-primary
}

// Overlay: ======================================================================================
hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// Xwayland: =====================================================================================
xwayland-satellite {
    off
    path "xwayland-satellite"
}

// Lid: ==========================================================================================
switch-events {
    lid-close { spawn "notify-send" "The laptop lid is closed!"; }
    lid-open { spawn "notify-send" "The laptop lid is open!"; }
}

// Debug: ========================================================================================
debug {
    keep-max-bpc-unchanged
    wait-for-frame-completion-before-queueing
    honor-xdg-activation-with-invalid-serial
}

// Cursor: =======================================================================================
cursor {
    xcursor-theme "BreezeX-Black"
    xcursor-size 30
    hide-when-typing
    hide-after-inactive-ms 2500
}

// ============================================================================== #
// Env:                                                                           #
// ============================================================================== #
environment {
    // Compositor: ===============================================================================
    DISPLAY ":0"
    DESKTOP_SESSION "niri"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "Niri"
    XDG_SESSION_TYPE "wayland"

    // Platform: =================================================================================
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_QPA_PLATFORMTHEME_QT6 "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_SCALE_FACTOR "1"

    // GTK: ======================================================================================
    GTK_IM_MODULE "simple"
    GTK_USE_PORTAL "1"
    GDK_SCALE "1"
    GDK_BACKEND "wayland,x11"

    // Firefox: ==================================================================================
    MOZ_ENABLE_WAYLAND "1"
    MOZ_DBUS_REMOTE "1"

    // Java: =====================================================================================
    _JAVA_AWT_WM_NONREPARENTING "1"

    // Sdl: ======================================================================================
    SDL_VIDEODRIVER "wayland"

    // Clutter: ==================================================================================
    CLUTTER_BACKEND "wayland"

    // Electron: =================================================================================
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Performance: ==============================================================================
    VDPAU_DRIVER "va_gl"
    LIBVA_DRIVER_NAME "iHD"
}

// ============================================================================== #
// Overview:                                                                      #
// ============================================================================== #
overview {
    zoom 0.6
    backdrop-color "#172526"
    workspace-shadow {
        on
        softness 5
        spread 4
        offset x=0 y=2
        color "#56827040"
    }
}

// ============================================================================== #
// Input:                                                                         #
// ============================================================================== #
input {
    // Keyboard: =================================================================================
    keyboard {
        xkb {
            layout "us,ara"
            options "caps:escape,altwin:menu_win,grp:win_space_toggle"
        }
        track-layout "window"
        repeat-delay 150
        repeat-rate 60
        numlock
    }

    // Touchpad: =================================================================================
    touchpad {
        tap
        dwt
        dwtp
        drag true
        natural-scroll
        accel-speed 0.4
        accel-profile "adaptive"
        scroll-method "two-finger"
        middle-emulation
        disabled-on-external-mouse
        scroll-factor 1.5
    }

    // Mouse: ====================================================================================
    mouse {
        accel-speed 0.4
        accel-profile "adaptive"
        middle-emulation
        scroll-factor 1.5
    }

    // trackpoint: ===============================================================================
    trackpoint {}

    // Others: ===================================================================================
    warp-mouse-to-focus
    disable-power-key-handling
    workspace-auto-back-and-forth
    focus-follows-mouse max-scroll-amount="0%"
    mod-key "Alt"
    mod-key-nested "Alt"
}

// ============================================================================== #
// Output:                                                                        #
// ============================================================================== #
output "eDP-1" {
    // Modes: ====================================================================================
    mode "1920x1200@60.026"

    // Scale: ====================================================================================
    scale 1

    // Rotate: ===================================================================================
    transform "normal"

    // Coordinate: ===============================================================================
    position x=0 y=0
}

// ============================================================================== #
// Workspaces:                                                                    #
// ============================================================================== #
workspace "1" {
    open-on-output "eDP-1"
}
workspace "2" {
    open-on-output "eDP-1"
}
workspace "3" {
    open-on-output "eDP-1"
}
workspace "4" {
    open-on-output "eDP-1"
}
workspace "5" {
    open-on-output "eDP-1"
}

// ============================================================================== #
// Layout:                                                                        #
// ============================================================================== #
layout {
    // Gaps: =====================================================================================
    gaps 0
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    // Hint: =====================================================================================
    insert-hint {
        on
        color "#131F2090"
    }

    // Ring: =====================================================================================
    focus-ring {
        off
        width 2
        active-color "#233935"
        inactive-color "#1D3334"
        urgent-color "#D2696C"

    }

    // Border: ===================================================================================
    border {
        off
        width 1
        active-color "#233935"
        inactive-color "#1D3334"
        urgent-color "#D2696C"
    }

    // Shadow: ===================================================================================
    shadow {
        on
        softness 4
        spread 2
        offset x=0 y=2
        color "#56827040"
    }

    // Width: ====================================================================================
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

   // Height: ====================================================================================
    preset-window-heights {
        proportion 0.2
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.8
        proportion 1.0
    }

   // Tabs: ======================================================================================
    tab-indicator {
        off
        hide-when-single-tab
        place-within-column
        gap 0
        width 10
        length total-proportion=1.0
        position "top"
        gaps-between-tabs 2
        corner-radius 0
        active-color "#233935"
        inactive-color "#172526"
        urgent-color "#9b0000"
    }

    // Others: ===================================================================================
    always-center-single-column
    center-focused-column "never"
    background-color "transparent"
    default-column-display "normal"
}

// ============================================================================== #
// Animations:                                                                    #
// ============================================================================== #
animations {
    // Workspace: ================================================================================
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // Window: ===================================================================================
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // Others: ===================================================================================
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

// ============================================================================== #
// Recent:                                                                        #
// ============================================================================== #
recent-windows {
    on
    debounce-ms 750
    open-delay-ms 150
    highlight {
        active-color "#88B497ff"
        urgent-color "#D2696Cff"
        padding 12
        corner-radius 0
    }
    previews {
        max-height 600
        max-scale 0.6
    }
    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }

        Mod+Tab         { next-window; }
        Mod+Shift+Tab   { previous-window; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

// ============================================================================== #
// Gestures:                                                                      #
// ============================================================================== #
gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }
    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }
    hot-corners {
        off
        top-left
        bottom-right
    }
}

// ============================================================================== #
// Rules:                                                                         #
// ============================================================================== #
// All: ==========================================================================================
window-rule {
    open-maximized true
}
window-rule {
    draw-border-with-background false
}
window-rule  {
    match is-urgent=true
    open-focused true
}
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
window-rule {
  match is-urgent=true
  baba-is-float true
}
window-rule {
  match is-floating=true
  border {
    off
  }
}

// Specific: =====================================================================================
window-rule {
  match app-id=r#"^special*"#
  default-column-width { proportion 0.80; }
  default-window-height { proportion 0.80; }
  open-floating true
  open-on-workspace "5"
}

// Dialogs: ======================================================================================
window-rule {
    match title=r#".*(Open|Save|Select).*"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 900
    max-height 1000
}
window-rule {
    match title=r#".*File.*"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 900
    max-height 1000
}
window-rule {
    match app-id=r#"org\.gtk\.FileChooserDialog"#
    open-floating true
    default-column-width { proportion 0.0; }
    max-width 900
    max-height 1000
}
window-rule {
    match title=r#".*Sign in - Google Accounts — Mozilla Firefox"#
    open-floating true
}
window-rule {
    match title=r#".*Account Setup - Mozilla Thunderbird"#
    open-floating true
}

window-rule {
    match title=r#".*(Dialog|Properties|Preferences|Settings|Rename).*"#
    open-floating true
}

// Authentication: ===============================================================================
window-rule {
    match app-id=r#"org\.kde\.polkit-kde-authentication-agent-1"#
    open-floating true
}
window-rule {
    match title=r#".*Authentication.*"#
    open-floating true
}

// Password: =====================================================================================
window-rule {
    match app-id=r#"org\.keepassxc\.KeePassXC"# title=r#".*Auto-Type.*"#
    open-floating true
}
window-rule {
    match app-id=r#"Bitwarden"# title=r#".*unlock.*"#
    open-floating true
}

// Utilities: ====================================================================================
window-rule {
    match app-id=r#"nm-connection-editor"#
    match app-id=r#"blueman-manager"#
    match app-id=r#"pavucontrol"#
    match app-id=r#"bluetui"#
    match app-id=r#"impala"#
    default-column-width { proportion 0.50; }
    default-window-height { proportion 0.50; }
    default-floating-position x=5 y=5 relative-to="bottom-left"
    open-floating true
}

// Media: ========================================================================================
window-rule {
    match app-id="^mpv$"
    match app-id="^imv$"
    tiled-state false
    open-floating true
}

// Others: =======================================================================================
window-rule {
  match title="^(file_progress)$"
  match title="^(confirm)$"
  match title="^(dialog)$"
  match title="^(download)$"
  match title="^(notification )$"
  match title="^(error)$"
  match title="^(splash)$"
  match title="^(nwg-look)$"
  match title="^(confirmreset)$"
  match title="^(Delete profile)$"
  match title="^(Open File)(.*)$"
  match title="^(Select a File)(.*)$"
  match title="^(Choose wallpaper)(.*)$"
  match title="^(Open Folder)(.*)$"
  match title="^(Save As)(.*)$"
  match title="^(Library)(.*)$"
  match title="^(File Upload)(.*)$"
  match title="^(hyprland-share-picker)$"
  match title="^(.*)-Google$"
  match title="^(.*)System Update$"
  match title="^File Operation Progress$"
  match title="^Confirm to replace files$"
  match title="^KDE Connect URL handler$"
  match title="^Picture-in-Picture$"
  open-floating true
}

// ============================================================================== #
// Layer:                                                                         #
// ============================================================================== #
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^[as]www-daemon$"
    place-within-backdrop true
}

// ============================================================================== #
// Keybidngs:                                                                     #
// ============================================================================== #
binds {
    // Scratchpad terminal: ==============================================================================
    SUPER+T                             { spawn "~/.config/niri/scripts/scratch.sh" "special-term"; }
    SUPER+B                             { spawn "~/.config/niri/scripts/scratch.sh" "special-btop"; }
    SUPER+N                             { spawn "~/.config/niri/scripts/scratch.sh" "special-files"; }
    SUPER+Y                             { spawn "~/.config/niri/scripts/scratch.sh" "special-files"; }

    // Scripts actions: ==========================================================================
    MOD+SHIFT+P                         { spawn "~/.config/fuzzel/modules/powermenu"; }
    MOD+SHIFT+U                         { spawn "~/.config/fuzzel/modules/umount"; }
    MOD+SHIFT+M                         { spawn "~/.config/fuzzel/modules/media"; }
    MOD+SHIFT+W                         { spawn "~/.config/fuzzel/modules/niri"; }
    MOD+SHIFT+I                         { spawn "~/.config/fuzzel/modules/wall"; }
    MOD+SHIFT+C                         { spawn "~/.config/fuzzel/modules/cliphist"; }
    MOD+SHIFT+B                         { spawn "~/.config/fuzzel/modules/calc"; }
    MOD+SHIFT+E                         { spawn "~/.config/fuzzel/modules/emoji"; }

    // Application shortcuts: ====================================================================
    MOD+RETURN                          { spawn "alacritty"; }
    MOD+SHIFT+RETURN                    { spawn "foot"; }
    MOD+SHIFT+N                         { spawn "nautilus"; }
    MOD+E                               { spawn "thunderbird"; }
    MOD+W                               { spawn "firefox"; }
    MOD+V                               { spawn "neovide"; }
    MOD+N                               { spawn "foot" "yazi"; }
    MOD+B                               { spawn "foot" "--app-id='bluetui'" "bluetui"; }
    MOD+I                               { spawn "foot" "--app-id='impala'" "impala"; }
	  MOD+D				                        { spawn "sh" "-c" "fuzzel --prompt='Apps Menu: ' --placeholder=\"  $(date '+%a %d-%m  󰥔 %R')\""; }

    // Media keys: ===============================================================================
    XF86AudioRaiseVolume                allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute                       allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay                       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop                       allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev                       allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext                       allow-when-locked=true { spawn "playerctl" "next"; }
    XF86MonBrightnessUp                 allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }
    XF86Calculator                      repeat=false { spawn "walker" "--provider" "calc"; }

    // Window management: ========================================================================
    MOD+Q                               { close-window; }
    MOD+J                               { focus-window-or-workspace-down; }
    MOD+K                               { focus-window-or-workspace-up; }
    MOD+H                               { focus-column-left; }
    MOD+L                               { focus-column-right; }
    MOD+LEFT                            { focus-column-left; }
    MOD+RIGHT                           { focus-column-right; }
    MOD+DOWN                            { focus-window-down; }
    MOD+UP                              { focus-window-up; }
    MOD+COMMA                           { consume-or-expel-window-left; }
    MOD+PERIOD                          { consume-or-expel-window-right; }
    MOD+SHIFT+T                         { consume-window-into-column; }

    // Move windows within workspace: ============================================================
    MOD+S                               { move-column-left; }
    MOD+SHIFT+J                         { move-window-down-or-to-workspace-down; }
    MOD+SHIFT+K                         { move-window-up-or-to-workspace-up; }
    MOD+SHIFT+H                         { move-column-left; }
    MOD+SHIFT+L                         { move-column-right; }
    MOD+SHIFT+LEFT                      { move-column-left; }
    MOD+SHIFT+DOWN                      { move-window-down; }
    MOD+SHIFT+UP                        { move-window-up; }
    MOD+SHIFT+RIGHT                     { move-column-right; }

    // Move to workspace edges: ==================================================================
    MOD+SHIFT+HOME                      { move-column-to-first; }
    MOD+SHIFT+END                       { move-column-to-last; }
    MOD+HOME                            { focus-column-first; }
    MOD+END                             { focus-column-last; }

    // Monitor management - move between monitors: ===============================================
    MOD+CONTROL+J                       { focus-monitor-down; }
    MOD+CONTROL+K                       { focus-monitor-up; }
    MOD+CONTROL+H                       { focus-monitor-left; }
    MOD+CONTROL+L                       { focus-monitor-right; }
    MOD+CONTROL+LEFT                    { focus-monitor-left; }
    MOD+CONTROL+RIGHT                   { focus-monitor-right; }
    MOD+CONTROL+UP                      { focus-monitor-up; }
    MOD+CONTROL+DOWN                    { focus-monitor-down; }

    // Move windows to different monitors: =======================================================
    MOD+SHIFT+CONTROL+LEFT              { move-column-to-monitor-left; }
    MOD+SHIFT+CONTROL+RIGHT             { move-column-to-monitor-right; }
    MOD+SHIFT+CONTROL+UP                { move-column-to-monitor-up; }
    MOD+SHIFT+CONTROL+DOWN              { move-column-to-monitor-down; }
    MOD+SHIFT+CONTROL+H                 { move-column-to-monitor-left; }
    MOD+SHIFT+CONTROL+L                 { move-column-to-monitor-right; }
    MOD+SHIFT+CONTROL+K                 { move-column-to-monitor-up; }
    MOD+SHIFT+CONTROL+J                 { move-column-to-monitor-down; }

    // Workspace Management: =====================================================================
    MOD+O                               repeat=false { toggle-overview; }
    MOD+WHEELSCROLLDOWN                 cooldown-ms=100 { focus-workspace-down; }
    MOD+WHEELSCROLLUP                   cooldown-ms=100 { focus-workspace-up; }

    // Move windows to different workspaces - using wheel matches K/J pattern: ===================
    MOD+SHIFT+WHEELSCROLLDOWN           cooldown-ms=100 { move-column-to-workspace-down; }
    MOD+SHIFT+WHEELSCROLLUP             cooldown-ms=100 { move-column-to-workspace-up; }

    // Column navigation with mouse: =============================================================
    MOD+WHEELSCROLLRIGHT                { focus-column-right; }
    MOD+WHEELSCROLLLEFT                 { focus-column-left; }
    MOD+CONTROL+WHEELSCROLLRIGHT        { move-column-right; }
    MOD+CONTROL+WHEELSCROLLLEFT         { move-column-left; }

    // Numbered workspaces: ======================================================================
    MOD+1                               { focus-workspace 1; }
    MOD+2                               { focus-workspace 2; }
    MOD+3                               { focus-workspace 3; }
    MOD+4                               { focus-workspace 4; }
    MOD+5                               { focus-workspace 5; }
    MOD+6                               { focus-workspace 6; }
    MOD+7                               { focus-workspace 7; }
    MOD+8                               { focus-workspace 8; }
    MOD+9                               { focus-workspace 9; }

    // Move windows to numbered workspaces with MOD+SHIFT: =======================================
    MOD+SHIFT+1                         { move-column-to-workspace 1; }
    MOD+SHIFT+2                         { move-column-to-workspace 2; }
    MOD+SHIFT+3                         { move-column-to-workspace 3; }
    MOD+SHIFT+4                         { move-column-to-workspace 4; }
    MOD+SHIFT+5                         { move-column-to-workspace 5; }
    MOD+SHIFT+6                         { move-column-to-workspace 6; }
    MOD+SHIFT+7                         { move-column-to-workspace 7; }
    MOD+SHIFT+8                         { move-column-to-workspace 8; }
    MOD+SHIFT+9                         { move-column-to-workspace 9; }
    MOD+BACKSPACE                       { focus-workspace-previous; }

    // Layout controls: ==========================================================================
    Mod+R                               { switch-preset-column-width; }
    Mod+SHIFT+R                         { switch-preset-window-height; }
    Mod+CONTROL+R                       { reset-window-height; }
    MOD+CONTROL+C                       { center-visible-columns; }
    Mod+MINUS                           { set-column-width "-10%"; }
    Mod+EQUAL                           { set-column-width "+10%"; }
    Mod+0                               { set-column-width "938"; }
    Mod+SHIFT+MINUS                     { set-window-height "-10%"; }
    Mod+Shift+EQUAL                     { set-window-height "+10%"; }
    MOD+BRACKETLEFT                     { set-column-width "-10%"; }
    MOD+BRACKETRIGHT                    { set-column-width "+10%"; }
    MOD+SHIFT+BRACKETLEFT               { set-window-height "-10%"; }
    MOD+SHIFT+BRACKETRIGHT              { set-window-height "+10%"; }

    // Window resizing with mouse: ===============================================================
    MOD+CONTROL+WHEELSCROLLDOWN         { set-window-height "-5%"; }
    MOD+CONTROL+WHEELSCROLLUP           { set-window-height "+5%"; }

    // Window Modes: =============================================================================
    MOD+SHIFT+SPACE                     { toggle-window-floating; }
    MOD+SPACE                           { switch-focus-between-floating-and-tiling; }
    MOD+CONTROL+F                       { fullscreen-window ; }
    MOD+SHIFT+F                         { toggle-windowed-fullscreen; }
    MOD+F                               { maximize-window-to-edges ; }
    MOD+M                               { maximize-column; }
    MOD+T                               { toggle-column-tabbed-display; }

    // Utils: ====================================================================================
    PRINT                               { screenshot; }
    MOD+PRINT                           { screenshot-screen write-to-disk=true; }
    MOD+CONTROL+PRINT                   { screenshot-window write-to-disk=true; }
    MOD+P                               { spawn-sh "niri msg pick-color| grep 'Hex:'| cut -d' ' -f2| wl-copy"; }
    Mod+X                               { spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg --json focused-window | jq .id)"; }

    // Shortcuts panel: ==========================================================================
    MOD+SHIFT+ESCAPE                    { show-hotkey-overlay; }
    Mod+SHIFT+Q                         { quit skip-confirmation=true; }
    Mod+CONTROL+Q                       { power-off-monitors; }
    Mod+Escape                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Application restarts: =====================================================================
    MOD+SUPER+W                         { spawn "sh" "-c" "pgrep -x waybar >/dev/null && killall waybar || waybar &"; }
}
