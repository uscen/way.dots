# =============================================================================== #
# Font:                                                                           #
# =============================================================================== #
set font "Jetbrains Mono Nerd Font"

# =============================================================================== #
# General:                                                                        #
# =============================================================================== #
set selection-clipboard clipboard
set page-padding 10
set incremental-search true
set window-title-home-tilde true
set window-title-basename true
set statusbar-home-tilde true
set adjust-open "best-fit"
set adjust-open "width"
set first-page-column 1:2
set recolor true
set recolor-keephue true
set sandbox strict
set guioptions ""

# =============================================================================== #
# Startup:                                                                        #
# =============================================================================== #
set adjust-open width
set recolor true
set smooth-scroll true
set show-v-scrollbar true

# =============================================================================== #
# Keybinds:                                                                       #
# =============================================================================== #
map w adjust_window width
map f adjust_window best-fit
map i zoom in
map o zoom out
map q quit
map r reload
map <C-Tab> toggle_statusbar
map <C-t> set recolor "false"
map <C-i> recolor

# =============================================================================== #
# Recolor:                                                                        #
# =============================================================================== #
set recolor-lightcolor "#172526"
set recolor-darkcolor "#DBD2C7"

# =============================================================================== #
# Themes:                                                                         #
# =============================================================================== #
# Completion: ====================================================================================
set completion-bg "#172526"
set completion-fg "#233935"
set completion-group-bg "#172526"
set completion-group-fg "#DBD2C7"
set completion-highlight-bg "#172526"
set completion-highlight-fg "#DBD2C7"

# Default: =======================================================================================
set default-bg "#172526"
set default-fg "#DBD2C7"

# Highlight: =====================================================================================
set highlight-active-color "#a292a3"
set highlight-color "#FFD7AA"

# Index: =========================================================================================
set index-active-bg "#172526"
set index-active-fg "#DBD2C7"
set index-bg "#172526"
set index-fg "#DBD2C7"

# Input: =========================================================================================
set inputbar-bg "#172526"
set inputbar-fg "#DBD2C7"

# Notifaction: ===================================================================================
set notification-bg "#172526"
set notification-error-bg "#D2696C"
set notification-error-fg "#DBD2C7"
set notification-fg "#DBD2C7"
set notification-warning-bg "#FFD7AA"
set notification-warning-fg "#233935"

# Render: ========================================================================================
set render-loading true
set render-loading-bg "#DBD2C7"
set render-loading-fg "#172526"

# Statusbar: =====================================================================================
set statusbar-bg "#172526"
set statusbar-fg "#DBD2C7"
