# =============================================================================== #
# Zathura:                                                                        #
# =============================================================================== #
# Font:                                                                           #
# =============================================================================== #
set font "Jetbrains Mono Nerd Font"

# =============================================================================== #
# Configs:                                                                        #
# =============================================================================== #
set selection-clipboard clipboard
set page-padding 10
set incremental-search true
set window-title-home-tilde true
set window-title-basename true
set statusbar-home-tilde true
set adjust-open "best-fit"
set adjust-open "width"
set first-page-column 1:2
set recolor true
set recolor-keephue true
set sandbox strict
set guioptions ""

# =============================================================================== #
# Startup:                                                                        #
# =============================================================================== #
set adjust-open width
set recolor true
set smooth-scroll true
set show-v-scrollbar true

# =============================================================================== #
# Keybinds:                                                                       #
# =============================================================================== #
map w adjust_window width
map f adjust_window best-fit
map i zoom in
map o zoom out
map q quit
map r reload
map <C-Tab> toggle_statusbar
map <C-t> set recolor "false"
map <C-i> recolor

# =============================================================================== #
# Themes:                                                                         #
# =============================================================================== #
set completion-bg "#101010"
set completion-fg "#424242"
set completion-group-bg "#101010"
set completion-group-fg "#c5c9c5"
set completion-highlight-bg "#101010"
set completion-highlight-fg "#c5c9c5"

set default-bg "#101010"
set default-fg "#c5c9c5"

set highlight-active-color "#a292a3"
set highlight-color "#c8ae81"

set index-active-bg "#101010"
set index-active-fg "#c5c9c5"
set index-bg "#101010"
set index-fg "#c5c9c5"

set inputbar-bg "#101010"
set inputbar-fg "#c5c9c5"

set notification-bg "#101010"
set notification-error-bg "#c4746e"
set notification-error-fg "#c5c9c5"
set notification-fg "#c5c9c5"
set notification-warning-bg "#c8ae81"
set notification-warning-fg "#424242"

set render-loading true
set render-loading-bg "#c5c9c5"
set render-loading-fg "#101010"

set statusbar-bg "#101010"
set statusbar-fg "#c5c9c5"

# =============================================================================== #
# Recolor:                                                                        #
# =============================================================================== #
set recolor-lightcolor "#101010"
set recolor-darkcolor "#c5c9c5"
