# =============================================================================== #
# Swaylock:                                                                       #
# =============================================================================== #
# =============================================================================== #
# General:                                                                        #
# =============================================================================== #
ignore-empty-password
daemonize
hide-keyboard-layout
indicator-caps-lock
# =============================================================================== #
# Image:                                                                          #
# =============================================================================== #
image=~/.local/share/wall.dots/wallpapers/GUTS.png
# =============================================================================== #
# Fonts:                                                                          #
# =============================================================================== #
font=JetBrains Mono Nerd Font
font-size=11
# =============================================================================== #
# Caps:                                                                           #
# =============================================================================== #
bs-hl-color=#101010cc
caps-lock-bs-hl-color=101010cc
caps-lock-key-hl-color=d3869bcc
# =============================================================================== #
# Indicator:                                                                      #
# =============================================================================== #
indicator-idle-visible
indicator-radius=100
indicator-thickness=200
# =============================================================================== #
# Inside:                                                                         #
# =============================================================================== #
inside-color=201d1d10
inside-clear-color=0d0e0c66
inside-caps-lock-color=0d0e0c66
inside-ver-color=0d0e0c66
inside-wrong-color=0d0e0c66
# =============================================================================== #
# Layout:                                                                         #
# =============================================================================== #
layout-bg-color=201d1d
layout-text-color=201d1d
# =============================================================================== #
# Ring:                                                                           #
# =============================================================================== #
ring-color=0d0c0c66
ring-clear-color=393836cc
ring-caps-lock-color=e78a4ecc
ring-ver-color=282727
ring-wrong-color=d7474bcc
# =============================================================================== #
# Text:                                                                           #
# =============================================================================== #
text-color=0d0c0c
text-clear-color=00000000
text-caps-lock-color=87a987
text-ver-color=00000000
text-wrong-color=00000000
# =============================================================================== #
# Others:                                                                         #
# =============================================================================== #
key-hl-color=0d0c0ccc
line-color=00000000
separator-color=00000000
