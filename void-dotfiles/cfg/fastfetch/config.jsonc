// # ============================================================================= #
// # General:                                                                      #
// # ============================================================================= #
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/lli/.config//fastfetch/assets/idk.png",
    "type": "chafa",
    "width": 30,
    "height": 10,
    "padding": {
      "top": 1,
      "left": 3,
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "             おかえり❣︎",
      "outputColor": "green",
    },
    {
      "type": "custom",
      "outputColor": "blue",
      "format": "┌─────────────────────────────────┐",
    },
    "break",
    {
      "type": "users",
      "key": "   ",
      "format": "{name} @ uscen",
      "keyColor": "green",
    },
    {
      "type": "host",
      "key": "   ",
      "format": "{2}",
      "keyColor": "green",
    },
    {
      "type": "os",
      "key": "   ",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "   ",
      "format": "{1}",
      "keyColor": "green",
    },
    {
      "type": "packages",
      "key": "   ",
      "keyColor": "green",
    },
    "break",
    {
      "type": "custom",
      "outputColor": "blue",
      "format": "└─────────────────────────────────┘",
    },
    {
      "type": "colors",
      "symbol": "square",
      "paddingLeft": 10,
    },
  ],
}
